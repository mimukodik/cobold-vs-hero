meta {
  name: 03 Shield-wall readiness
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/cobold-vs-hero/briefing
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "changeTitle": "Production release without rollback",
    "changeDescription": "Deploy a production payment retry fix with test and browser evidence but no rollback path.",
    "affectedSurfaces": ["backend", "bff", "frontend", "contract", "testing"],
    "riskFlags": ["production"]
  }
}

assert {
  res.status: eq 200
  res.body.signal: eq shield-wall
  res.body.requiredEvidence[6]: eq rollback
  res.body.readinessVerdict: eq NOT_READY
  res.body.evidenceItems[4].approverRole: eq tech-lead
}
